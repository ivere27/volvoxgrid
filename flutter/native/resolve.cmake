# Shared desktop resolver. Downloads/extracts only into the consuming build tree.
# Precedence: environment override, CMake -D override, package pubspec version,
# then the immediate monorepo VERSION (only in a recognized source checkout).
get_filename_component(VOLVOXGRID_PACKAGE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
get_filename_component(_v_repo "${VOLVOXGRID_PACKAGE_ROOT}/.." REALPATH)
set(_v_is_repo FALSE)
if(EXISTS "${_v_repo}/Cargo.toml" AND IS_DIRECTORY "${_v_repo}/engine")
  set(_v_is_repo TRUE)
endif()
foreach(_v_name SOURCE VERSION GROUP ARTIFACT MAVEN_REPOSITORY LIBRARY VARIANT)
  if(DEFINED ENV{VOLVOXGRID_${_v_name}} AND NOT "$ENV{VOLVOXGRID_${_v_name}}" STREQUAL "")
    set(VOLVOXGRID_${_v_name} "$ENV{VOLVOXGRID_${_v_name}}")
  endif()
endforeach()
if(NOT VOLVOXGRID_SOURCE)
  set(VOLVOXGRID_SOURCE "maven")
endif()
if(NOT VOLVOXGRID_SOURCE STREQUAL "local" AND NOT VOLVOXGRID_SOURCE STREQUAL "maven")
  message(FATAL_ERROR "VolvoxGrid: Invalid VOLVOXGRID_SOURCE='${VOLVOXGRID_SOURCE}'. Expected local or maven.")
endif()
if(NOT VOLVOXGRID_VERSION AND EXISTS "${VOLVOXGRID_PACKAGE_ROOT}/pubspec.yaml")
  file(STRINGS "${VOLVOXGRID_PACKAGE_ROOT}/pubspec.yaml" _v_versions REGEX "^version:[ \t]*")
  if(_v_versions)
    list(GET _v_versions 0 _v_version_line)
    string(REGEX REPLACE "^version:[ \t]*[\"']?([^ \t\r\n\"'+#]+).*" "\\1" VOLVOXGRID_VERSION "${_v_version_line}")
  endif()
endif()
if(NOT VOLVOXGRID_VERSION AND _v_is_repo AND EXISTS "${_v_repo}/VERSION")
  file(READ "${_v_repo}/VERSION" VOLVOXGRID_VERSION)
  string(STRIP "${VOLVOXGRID_VERSION}" VOLVOXGRID_VERSION)
endif()
if(NOT VOLVOXGRID_VERSION MATCHES "^[0-9][A-Za-z0-9._+-]*$")
  message(FATAL_ERROR "VolvoxGrid: Cannot resolve native version. Set VOLVOXGRID_VERSION or restore the package pubspec.yaml version.")
endif()

if(VOLVOXGRID_VARIANT STREQUAL "lite" AND (VOLVOXGRID_PLATFORM STREQUAL "linux" OR VOLVOXGRID_PLATFORM STREQUAL "windows"))
  message(FATAL_ERROR "VolvoxGrid: ${VOLVOXGRID_PLATFORM} requires the full native text renderer. Unset VOLVOXGRID_VARIANT; lite is supported on Android, iOS and macOS.")
endif()

if(VOLVOXGRID_SOURCE STREQUAL "local")
  if(VOLVOXGRID_VARIANT STREQUAL "lite" AND NOT VOLVOXGRID_LIBRARY)
    message(FATAL_ERROR "VolvoxGrid: Local lite builds require VOLVOXGRID_LIBRARY pointing to the lite native binary; a generic target library may be the full engine.")
  endif()
  if(VOLVOXGRID_LIBRARY)
    # An explicit path must be valid; do not silently substitute another build.
    set(_v_candidates "${VOLVOXGRID_LIBRARY}")
  else()
    set(_v_candidates "${VOLVOXGRID_PACKAGE_ROOT}/${VOLVOXGRID_PLATFORM}/x64/${VOLVOXGRID_NATIVE_NAME}")
    if(_v_is_repo)
      list(APPEND _v_candidates "${_v_repo}/target/release/${VOLVOXGRID_NATIVE_NAME}" "${_v_repo}/target/debug/${VOLVOXGRID_NATIVE_NAME}")
    endif()
  endif()
  foreach(_v_candidate IN LISTS _v_candidates)
    if(EXISTS "${_v_candidate}" AND NOT IS_DIRECTORY "${_v_candidate}")
      set(VOLVOXGRID_RESOLVED_LIBRARY "${_v_candidate}")
      break()
    endif()
  endforeach()
  if(NOT VOLVOXGRID_RESOLVED_LIBRARY)
    message(FATAL_ERROR "VolvoxGrid: No local ${VOLVOXGRID_NATIVE_NAME}. Build the engine, set VOLVOXGRID_LIBRARY to the native library, or use VOLVOXGRID_SOURCE=maven. Searched: ${_v_candidates}")
  endif()
else()
  if(NOT VOLVOXGRID_GROUP)
    set(VOLVOXGRID_GROUP "io.github.ivere27")
  endif()
  if(NOT VOLVOXGRID_ARTIFACT)
    set(VOLVOXGRID_ARTIFACT "volvoxgrid-desktop")
    if(VOLVOXGRID_VARIANT STREQUAL "lite")
      set(VOLVOXGRID_ARTIFACT "volvoxgrid-desktop-lite")
    endif()
  endif()
  if(NOT VOLVOXGRID_MAVEN_REPOSITORY)
    set(VOLVOXGRID_MAVEN_REPOSITORY "https://repo.maven.apache.org/maven2")
  endif()
  string(REPLACE "." "/" _v_group_path "${VOLVOXGRID_GROUP}")
  set(_v_url "${VOLVOXGRID_MAVEN_REPOSITORY}/${_v_group_path}/${VOLVOXGRID_ARTIFACT}/${VOLVOXGRID_VERSION}/${VOLVOXGRID_ARTIFACT}-${VOLVOXGRID_VERSION}.jar")
  string(SHA256 _v_key "${_v_url}/${VOLVOXGRID_NATIVE_ARCH}")
  set(_v_dir "${CMAKE_CURRENT_BINARY_DIR}/volvoxgrid-native/${_v_key}")
  set(_v_member "native/${VOLVOXGRID_NATIVE_ARCH}/${VOLVOXGRID_NATIVE_NAME}")
  set(VOLVOXGRID_RESOLVED_LIBRARY "${_v_dir}/${_v_member}")
  if(NOT EXISTS "${VOLVOXGRID_RESOLVED_LIBRARY}")
    file(MAKE_DIRECTORY "${_v_dir}")
    message(STATUS "VolvoxGrid: Downloading ${_v_url} (${VOLVOXGRID_NATIVE_ARCH})")
    file(DOWNLOAD "${_v_url}" "${_v_dir}/native.jar.part" STATUS _v_download_status TLS_VERIFY ON TIMEOUT 180)
    list(GET _v_download_status 0 _v_download_code)
    list(GET _v_download_status 1 _v_download_message)
    if(NOT _v_download_code EQUAL 0)
      file(REMOVE "${_v_dir}/native.jar.part")
      message(FATAL_ERROR "VolvoxGrid: Cannot download ${_v_url}: ${_v_download_message}. Check network/proxy and VOLVOXGRID_VERSION (default: package version). For an offline/source build set VOLVOXGRID_SOURCE=local and VOLVOXGRID_LIBRARY to the native library. No Gradle installation is required.")
    endif()
    file(RENAME "${_v_dir}/native.jar.part" "${_v_dir}/native.jar")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${_v_dir}/native.jar" "${_v_member}"
      WORKING_DIRECTORY "${_v_dir}" RESULT_VARIABLE _v_extract_result ERROR_VARIABLE _v_extract_error)
    if(NOT _v_extract_result EQUAL 0 OR NOT EXISTS "${VOLVOXGRID_RESOLVED_LIBRARY}")
      message(FATAL_ERROR "VolvoxGrid: ${_v_url} does not provide ${_v_member}: ${_v_extract_error}. Check artifact version and supported target architecture, or use VOLVOXGRID_SOURCE=local with VOLVOXGRID_LIBRARY.")
    endif()
  endif()
endif()
message(STATUS "VolvoxGrid: ${VOLVOXGRID_SOURCE} ${VOLVOXGRID_VERSION}: ${VOLVOXGRID_RESOLVED_LIBRARY}")
