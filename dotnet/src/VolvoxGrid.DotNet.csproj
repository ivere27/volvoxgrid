<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="'$(VolvoxGridLegacyOnly)' != 'true' and ('$(OS)' == 'Windows_NT' or '$(IncludeWindowsDesktopTarget)' == 'true')">net8.0;net8.0-windows;net40</TargetFrameworks>
    <TargetFrameworks Condition="'$(VolvoxGridLegacyOnly)' != 'true' and '$(TargetFrameworks)' == ''">net8.0;net40</TargetFrameworks>
    <TargetFrameworks Condition="'$(VolvoxGridLegacyOnly)' == 'true'">net40</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>VolvoxGrid.DotNet</AssemblyName>
    <RootNamespace>VolvoxGrid.DotNet</RootNamespace>
    <NoWarn>1591</NoWarn>
    <PackageId>VolvoxGrid.DotNet</PackageId>
    <PackageId Condition="'$(VolvoxGridPackageId)' != ''">$(VolvoxGridPackageId)</PackageId>
    <Description>VolvoxGrid .NET bindings with WinForms and cross-platform controller support.</Description>
    <Description Condition="'$(VolvoxGridPackageId)' == 'VolvoxGrid.DotNet.Lite'">VolvoxGrid .NET bindings packaged with lite native binaries and OS text rendering fallback.</Description>
    <PackageTags>volvoxgrid;datagrid;winforms;dotnet;cross-platform</PackageTags>
    <PackageTags Condition="'$(VolvoxGridPackageId)' == 'VolvoxGrid.DotNet.Lite'">volvoxgrid;datagrid;winforms;dotnet;lite</PackageTags>
    <RepositoryUrl>https://github.com/ivere27/volvoxgrid</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ivere27/volvoxgrid</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net40'">
    <VolvoxGridNuGetPackageRoot Condition="'$(VolvoxGridNuGetPackageRoot)' == '' and '$(NuGetPackageRoot)' != ''">$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))</VolvoxGridNuGetPackageRoot>
    <VolvoxGridNuGetPackageRoot Condition="'$(VolvoxGridNuGetPackageRoot)' == '' and '$(NUGET_PACKAGES)' != ''">$([MSBuild]::EnsureTrailingSlash('$(NUGET_PACKAGES)'))</VolvoxGridNuGetPackageRoot>
    <VolvoxGridNuGetPackageRoot Condition="'$(VolvoxGridNuGetPackageRoot)' == '' and '$(HOME)' != ''">$([MSBuild]::EnsureTrailingSlash('$(HOME)/.nuget/packages'))</VolvoxGridNuGetPackageRoot>
    <VolvoxGridNuGetPackageRoot Condition="'$(VolvoxGridNuGetPackageRoot)' == '' and '$(USERPROFILE)' != ''">$([MSBuild]::EnsureTrailingSlash('$(USERPROFILE)/.nuget/packages'))</VolvoxGridNuGetPackageRoot>
    <FrameworkPathOverride>$(VolvoxGridNuGetPackageRoot)microsoft.netframework.referenceassemblies.net40/1.0.3/build/.NETFramework/v4.0/</FrameworkPathOverride>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net40" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Data" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="common/**" />
    <Compile Remove="net40/**" />
    <Compile Remove="net8/**" />
    <EmbeddedResource Remove="common/**" />
    <EmbeddedResource Remove="net40/**" />
    <EmbeddedResource Remove="net8/**" />
    <None Remove="common/**" />
    <None Remove="net40/**" />
    <None Remove="net8/**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Include="common/**/*.cs" Exclude="common/obj/**/*.cs" />
    <Compile Remove="common/VolvoxGridControl.cs" />
    <Compile Remove="common/Volvox/RenderHostCpu.cs" />
    <Compile Remove="common/Volvox/GdiTextRendererBridge.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <Compile Include="common/**/*.cs" Exclude="common/obj/**/*.cs" />
    <Compile Remove="common/VolvoxGridTerminalHost.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0' and '$(TargetFramework)' != 'net40'">
    <Compile Include="common/**/*.cs" Exclude="common/obj/**/*.cs" />
  </ItemGroup>

  <!--
    NuGet native asset packaging.

    On `dotnet pack`, the project picks up shared libraries built into
    $(VolvoxGridNativeRoot) and ships them under runtimes/<RID>/native/* in the
    package, so consumers automatically receive the correct native binary for
    their target RID without setting LD_LIBRARY_PATH or copying files manually.

    Layout expected at pack time (override $(VolvoxGridNativeRoot) on the
    command line, default: ../target/dotnet/native/):

      $(VolvoxGridNativeRoot)win-x64/volvoxgrid.dll
      $(VolvoxGridNativeRoot)win-x86/volvoxgrid.dll
      $(VolvoxGridNativeRoot)linux-x64/libvolvoxgrid.so
      $(VolvoxGridNativeRoot)linux-arm64/libvolvoxgrid.so
      $(VolvoxGridNativeRoot)osx-x64/libvolvoxgrid.dylib
      $(VolvoxGridNativeRoot)osx-arm64/libvolvoxgrid.dylib

    Missing files for a given RID are silently skipped (Condition="Exists(...)"),
    so dev `dotnet build` works on a single host without all 6 binaries present.
  -->
  <PropertyGroup>
    <VolvoxGridNativeRoot Condition="'$(VolvoxGridNativeRoot)' == ''">$(MSBuildThisFileDirectory)../../target/dotnet/native/</VolvoxGridNativeRoot>
  </PropertyGroup>

  <ItemGroup>
    <_VolvoxNative Include="$(VolvoxGridNativeRoot)win-x64/volvoxgrid.dll"     RID="win-x64"     Condition="Exists('$(VolvoxGridNativeRoot)win-x64/volvoxgrid.dll')" />
    <_VolvoxNative Include="$(VolvoxGridNativeRoot)win-x86/volvoxgrid.dll"     RID="win-x86"     Condition="Exists('$(VolvoxGridNativeRoot)win-x86/volvoxgrid.dll')" />
    <_VolvoxNative Include="$(VolvoxGridNativeRoot)linux-x64/libvolvoxgrid.so" RID="linux-x64"   Condition="Exists('$(VolvoxGridNativeRoot)linux-x64/libvolvoxgrid.so')" />
    <_VolvoxNative Include="$(VolvoxGridNativeRoot)linux-arm64/libvolvoxgrid.so" RID="linux-arm64" Condition="Exists('$(VolvoxGridNativeRoot)linux-arm64/libvolvoxgrid.so')" />
    <_VolvoxNative Include="$(VolvoxGridNativeRoot)osx-x64/libvolvoxgrid.dylib" RID="osx-x64"   Condition="Exists('$(VolvoxGridNativeRoot)osx-x64/libvolvoxgrid.dylib')" />
    <_VolvoxNative Include="$(VolvoxGridNativeRoot)osx-arm64/libvolvoxgrid.dylib" RID="osx-arm64" Condition="Exists('$(VolvoxGridNativeRoot)osx-arm64/libvolvoxgrid.dylib')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="@(_VolvoxNative)">
      <Pack>true</Pack>
      <PackagePath>runtimes/%(RID)/native/%(Filename)%(Extension)</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
